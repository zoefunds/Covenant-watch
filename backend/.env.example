# Copy to .env for local dev. NEVER commit a real .env (see .gitignore).

# --- App ---
ENV=development
APP_NAME=covenant-watch-api
LOG_LEVEL=INFO

# --- Database (Postgres, SQLAlchemy async-safe DSN via psycopg3) ---
DATABASE_URL=postgresql+psycopg://covenant:covenant@localhost:5432/covenant_watch

# --- Auth / sessions ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string
SESSION_TTL_SECONDS=43200
NONCE_TTL_SECONDS=300
SESSION_COOKIE_NAME=cw_session
# Set to false ONLY for local http (non-TLS) dev. Must be true in prod.
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- GenLayer chain / contract ---
# Filled in after the user's own GenLayer deployment via genlayer-cli.
# Example of what this looks like once deployed (from this project's own
# Audited StudioNet deployment): CONTRACT_ADDRESS=0x5c3Fe893aaaa9C0416F76812c3903Cf4AfA528A7
CONTRACT_ADDRESS=0x5c3Fe893aaaa9C0416F76812c3903Cf4AfA528A7
# One of: localnet, studionet, testnet_asimov, testnet_bradbury
GENLAYER_NETWORK=studionet
# Optional: override the network's default RPC URL.
GENLAYER_RPC_URL=
INDEXER_POLL_INTERVAL_SECONDS=300
INDEXER_ENABLED=true

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting (defense-in-depth ONLY -- the contract's own on-chain
# cooldown is the real enforcement boundary, see app/models/rate_limit.py) ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WRITE_ADJACENT=30/minute

# --- Observability ---
# Leave unset for a safe no-op (see app/core/sentry.py).
SENTRY_DSN=

# --- Redis (distributed coordination) ---
# Used for two things: (1) the shared hourly budget for outbound genlayer-py
# RPC calls (app/services/rpc_budget.py), keeping this backend comfortably
# under GenLayer's account-wide 5000 requests/hour limit even with multiple
# Fly.io machines + the indexer polling loop; (2) Redis-backed slowapi
# storage so per-address rate limits are consistent across machines instead
# of each one keeping its own in-process counter.
# Local dev default below is a plain local Redis (see docker-compose.yml's
# optional `redis` service, or run your own). Production points this at a
# real Upstash `rediss://...` TLS URL supplied out-of-band -- NEVER commit
# the real value here or anywhere else; it belongs only in backend/.env.
REDIS_URL=redis://localhost:6379/0
# Hard cap on outbound genlayer-py calls per rolling UTC hour, shared across
# all instances via REDIS_URL. GenLayer's real limit (confirmed live) is
# 500/hour account-wide -- this stays well under that with headroom for
# the frontend's own direct browser->RPC reads, which this budget cannot
# see or count at all.
GENLAYER_RPC_HOURLY_BUDGET=300
