# Copy to .env for local dev. NEVER commit a real .env (see .gitignore).

# --- App ---
ENV=development
APP_NAME=covenant-watch-backend
LOG_LEVEL=INFO

# --- Database (Postgres, SQLAlchemy async-safe DSN via psycopg3) ---
DATABASE_URL=postgresql+psycopg://covenant:covenant@localhost:5432/covenant_watch

# --- Auth / sessions ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string
SESSION_TTL_SECONDS=43200
NONCE_TTL_SECONDS=300
SESSION_COOKIE_NAME=cw_session
# Set to false ONLY for local http (non-TLS) dev. Must be true in prod.
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- GenLayer chain / contract ---
# Filled in after the user's own GenLayer deployment via genlayer-cli.
# Example of what this looks like once deployed (from this project's own
# StudioNet deployment): CONTRACT_ADDRESS=0x078485282E589a2cb43F6D3263753402045b7192
CONTRACT_ADDRESS=
# One of: localnet, studionet, testnet_asimov, testnet_bradbury
GENLAYER_NETWORK=studionet
# Optional: override the network's default RPC URL.
GENLAYER_RPC_URL=
INDEXER_POLL_INTERVAL_SECONDS=8
INDEXER_ENABLED=true

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting (defense-in-depth ONLY -- the contract's own on-chain
# cooldown is the real enforcement boundary, see app/models/rate_limit.py) ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WRITE_ADJACENT=30/minute

# --- Observability ---
# Leave unset for a safe no-op (see app/core/sentry.py).
SENTRY_DSN=
