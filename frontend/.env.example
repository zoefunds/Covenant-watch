# Audited Covenant Watch deployment; replace only when deploying this source again.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x1EC71Df45C68F9F52A155DbBC8def172B00819C4

# One of: localnet | studionet | testnetAsimov | testnetBradbury | mainnet
# (must match the chain the address above is actually deployed on)
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# FastAPI backend base URL (see backend/README.md). It provides SIWE auth,
# informational URL previews, health, and a non-authoritative indexed cache.
# Contract reads/writes used by the application remain direct-to-chain.
NEXT_PUBLIC_BACKEND_URL=https://covenant-watch-api.fly.dev

NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com/
NEXT_PUBLIC_BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_BASE_ESCROW_ADDRESS=0x37913648E096a6E8e97A2f5F31473e31c90c2Fb2
